{
  "manifest_version": 3,
  "name": "ÇevirmenX",
  "short_name": "ÇevirmenX",
  "version": "1.4.0",
  "version_name": "1.4.0",
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://cevir.haking.tr/",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "interface-copy.js",
        "content.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "https://cevir.haking.tr/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "cevir_kisayol": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Seçili metni çevir"
    }
  },
  "host_permissions": [
    "https://api.mymemory.translated.net/",
    "https://translate.googleapis.com/"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "default_locale": "en"
}