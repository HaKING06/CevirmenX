{
  "manifest_version": 3,
  "name": "ÇevirmenX",
  "short_name": "ÇevirmenX",
  "version": "1.3.2",
  "version_name": "1.3.2",
  "description": "Seçili metni çevirin; özel sözlük, sağ tık menüsü ve kısayolla kontrol sizde olsun.",
  "homepage_url": "https://cevir.haking.tr/",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "https://cevir.haking.tr/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "cevir_kisayol": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Seçili metni çevir"
    }
  },
  "host_permissions": [
    "https://api.mymemory.translated.net/",
    "https://translate.googleapis.com/"
  ],
  "icons": {
    "128": "icon.png"
  }
}